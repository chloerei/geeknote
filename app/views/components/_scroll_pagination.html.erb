<%# locals: (pagy:, content_html: {}, auto_load: false, direction: "down") %>

<%# Merge data attributes, keeping any controllers declared by the caller. %>
<% controllers = ["scroll-pagination", content_html.dig(:data, :controller)].compact.join(" ").split.uniq %>

<% wrapper_attrs = {
  id: "scroll-pagination",
  class: "",
  data: {
    controller: controllers.join(" "),
    scroll_pagination_target: "wrapper",
    scroll_pagination_auto_load_value: auto_load,
  },
}.deep_merge(content_html) %>

<% wrapper_attrs[:data][:controller] = controllers.join(" ") %>

<%= content_tag :div, **wrapper_attrs do %>
  <% if direction == "up" %>
    <% if pagy.next %>
      <a href="<%= pagy_url_for(pagy, pagy.next) %>" class="btn btn-ghost btn-block" data-action="scroll-pagination#load" data-scroll-pagination-target="nextLink" data-turbo-prefetch="false">
        <%= t "general.load_more" %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up-icon lucide-chevron-up"><path d="m18 15-6-6-6 6"/></svg>
      </a>
    <% else %>
      <div class="text-center text-xs opacity-60 py-4"><%= t "general.begin_label" %></div>
    <% end %>
  <% end %>

  <%= yield %>

  <% if direction == "down" %>
    <% if pagy.next %>
      <a href="<%= pagy_url_for(pagy, pagy.next) %>" class="btn btn-ghost btn-block" data-action="scroll-pagination#load" data-scroll-pagination-target="nextLink" data-turbo-prefetch="false">
        <%= t "general.load_more" %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
      </a>
    <% else %>
      <div class="text-center text-xs opacity-60 py-4"><%= t "general.end_label" %></div>
    <% end %>
  <% end %>
<% end %>
