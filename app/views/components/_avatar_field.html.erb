<%# locals: (form:, name:, label: nil, description: nil, options: {}) %>

<%
  error = form.object && form.object.errors[name].first
%>

<fieldset class="fieldset">
  <legend class="fieldset-legend">
    <%= form.label name, label %>
  </legend>

  <div class="group/image-field <%= 'attached' if form.object.send(name).attached? %>" data-controller="image-field">
    <div class="hidden">
      <%= form.file_field name, options.merge(accept: "image/png,image/jpeg", data: { image_field_target: "input", action: "image-field#upload", image_field_url_value: rails_direct_uploads_path }) %>
      <%= form.text_field name, options.merge(value: "", disabled: true, id: form.field_id(name, :signed_id), class: "hidden", data: { image_field_target: "signedIdInput" }) %>
    </div>
    <div class="relative w-32 h-32">
      <div class="absolute inset-0 [&>img]:object-cover [&>img]:h-full [&>img]:w-full [&>img]:rounded-full" data-image-field-target="preview">
        <% if form.object.send(name).attached? %>
          <%= image_tag form.object.send(name) %>
        <% end %>
      </div>

      <label for="<%= form.field_id name %>" class="absolute inset-0 flex flex-col items-center justify-center gap-2 group-[.attached]/image-field:hidden group-[.uploading]/image-field:hidden rounded-full border-2 border-dashed border-base-300 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image-plus-icon lucide-image-plus"><path d="M16 5h6"/><path d="M19 2v6"/><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/><circle cx="9" cy="9" r="2"/></svg>
      </label>

      <div class="absolute inset-0 hidden items-center justify-center rounded-full bg-base-100/70 group-[.uploading]/image-field:flex">
        <div class="text-sm font-medium tabular-nums">
          <span data-image-field-target="progress">0</span>%
        </div>
      </div>

      <div class="absolute top-2 right-2 flex items-center gap-2">
        <div class="bg-surface-variant rounded-full hidden group-[.uploading]/image-field:block">
          <button type="button" class="btn btn-soft btn-circle" data-action="image-field#cancel" aria-label="<%= t "general.cancel_upload" %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
        <div class="bg-surface-variant rounded-full hidden group-[.attached]/image-field:block group-[.uploading]/image-field:hidden">
          <label for="<%= form.field_id name %>" class="btn btn-soft btn-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image-plus-icon lucide-image-plus"><path d="M16 5h6"/><path d="M19 2v6"/><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/><circle cx="9" cy="9" r="2"/></svg>
          </label>
        </div>
      </div>
    </div>
  </div>

  <% if error %>
    <p class="label text-error">
      <%= error %>
    </p>
  <% elsif description %>
    <p class="label">
      <%= description %>
    </p>
  <% end %>
</fieldset>
