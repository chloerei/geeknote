<div class="min-h-dvh flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-screen-sm">
    <div class="card card-default">
      <div class="card-body text-center">
        <div class="mx-auto w-fit">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hourglass-icon lucide-hourglass text-base-content/40"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg>
        </div>

        <h1 class="text-xl font-medium mt-4">
          <%= t ".title" %>
        </h1>

        <p class="text-sm text-base-content/70 mt-2">
          <%= t ".description" %>
        </p>

        <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:justify-center">
          <a href="<%= root_path %>" class="btn btn-ghost">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <%= t "general.home" %>
          </a>
          <a href="<%= new_registration_path %>" class="btn btn-soft">
            <%= t "general.sign_up_account" %>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
