<div class="navbar px-0 gap-4">
  <div class="flex-none flex items-center gap-2">
    <a href="<%= settings_root_path %>" class="btn btn-square btn-ghost">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    </a>
  </div>
  <div class="flex-grow">
    <div class="text-xl font-medium">
      <%= t "general.delete_account" %>
    </div>
  </div>
</div>

<div class="layout-main-sidebar">
  <div>
    <div class="card card-default">
      <div class="card-body">
        <div class="alert alert-error">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert-icon lucide-triangle-alert"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          <span>
            <%= t ".warning" %>
          </span>
        </div>

        <div class="mt-4">
          <p class="text-sm text-base-content/70">
            <%= t ".notice_html", name: tag.strong(@user.account.name) %>
          </p>

          <ul class="list-disc list-inside mt-3 space-y-1 text-sm text-base-content/80">
            <li><%= t ".notice_posts_html", count: tag.strong(@user.account.posts.count) %></li>
            <li><%= t ".notice_comments_html", count: tag.strong(@user.comments.count) %></li>
            <li><%= t ".notice_irreversible" %></li>
          </ul>
        </div>

        <div class="divider"></div>

        <%= form_with url: settings_account_deletion_path, method: :post do |form| %>
          <div data-controller="confirmation" data-confirmation-required-value="<%= @user.account.name %>">
            <label class="label">
              <span class="label-text font-medium">
                <%= t ".account_name_label_html", name: tag.strong(@user.account.name) %>
              </span>
            </label>
            <input
              type="text"
              name="name"
              class="input input-bordered w-full"
              placeholder="<%= @user.account.name %>"
              autocomplete="off"
              autocapitalize="none"
              spellcheck="false"
              data-confirmation-target="input"
              data-action="input->confirmation#update"
              required
            >

            <div class="mt-4">
              <button type="submit" class="btn btn-error" data-confirmation-target="submit" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2-icon lucide-trash-2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                <%= t "general.delete_account" %>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
