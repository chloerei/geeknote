<div class="navbar px-0 gap-4">
  <div class="flex-none">
    <a href="<%= settings_root_path %>" class="btn btn-square btn-ghost">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    </a>
  </div>
  <div class="grow">
    <div class="text-xl font-medium">
      <%= t "general.theme" %>
    </div>
  </div>
</div>

<div class="layout-main-sidebar">
  <div>
    <div class="card card-default" data-controller="theme">
      <div class="card-body">
        <div role="radiogroup" aria-label="<%= t "general.theme" %>" class="space-y-2">
          <% { light: ".light", dark: ".dark", system: ".system" }.each do |mode, key| %>
            <label class="flex gap-4 relative cursor-pointer p-3 rounded-box hover:bg-base-200 has-[:checked]:bg-base-200">
              <div class="flex-none">
                <input type="radio" name="theme" value="<%= mode %>" class="radio"
                       data-theme-target="input" data-action="change->theme#select">
              </div>
              <div class="flex-grow">
                <div class="font-medium">
                  <%= t "settings.themes.show#{key}" %>
                </div>
                <div class="text-sm text-base-content/80">
                  <%= t "settings.themes.show#{key}_description" %>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
