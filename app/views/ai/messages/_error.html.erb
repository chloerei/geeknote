<div id="ai_message_<%= message.id %>" class="chat chat-start">
  <div class="chat-header">
    <%= title.presence || t(".name") %>
    <time class="text-xs opacity-50"><%= format_time message.created_at %></time>
  </div>
  <div class="chat-bubble chat-bubble-error whitespace-pre-wrap"><%= error_message %></div>
</div>
