<div id="ai_message_<%= message.id %>" class="flex justify-start">
  <div class="max-w-[85%]">
    <div class="mb-1 flex items-baseline gap-2 px-1 text-xs text-base-content/50">
      <span class="font-medium text-error"><%= title.presence || t ".name" %></span>
      <time><%= format_time message.created_at %></time>
    </div>
    <div class="rounded-2xl rounded-tl-sm bg-error/10 px-4 py-2.5 text-error whitespace-pre-wrap break-words"><%= error_message %></div>
  </div>
</div>
