<% assistant ||= local_assigns[:message] %>
<% tool_calls = assistant.ruby_llm_tool_calls.includes(result: :ruby_llm_parent_tool_call).load %>
<div id="ai_message_<%= assistant.id %>" class="flex justify-start">
  <div class="min-w-0 w-full break-words px-4">
    <%# A row that only carries tool calls has no streamed content of its own,
        so skip the (loading) content bubble and show the tool calls directly. %>
    <% if assistant.content.present? || tool_calls.empty? %>
      <div data-controller="streaming-markdown">
        <div id="ai_message_<%= assistant.id %>_content" data-streaming-markdown-target="raw" class="chat-raw whitespace-pre-wrap"><%= assistant.content %></div>
        <div data-streaming-markdown-target="rendered" class="chat-markdown typography">
          <% if assistant.content.blank? %>
            <span class="loading loading-dots loading-sm" role="status"></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <% tool_calls.each do |record| %>
      <%= render "ai/messages/tool_call", tool_call_record: record %>
    <% end %>
  </div>
</div>
