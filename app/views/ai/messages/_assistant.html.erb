<% assistant ||= local_assigns[:message] %>
<div id="ai_message_<%= assistant.id %>" class="chat chat-start">
  <div class="chat-header">
    <%= t ".name" %>
    <time class="text-xs opacity-50"><%= format_time assistant.created_at %></time>
  </div>
  <div id="ai_message_<%= assistant.id %>_content" class="chat-bubble chat-bubble-neutral whitespace-pre-wrap"><%= assistant.content %></div>
</div>
