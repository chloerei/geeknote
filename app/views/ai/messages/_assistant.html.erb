<% assistant ||= local_assigns[:message] %>
<div id="ai_message_<%= assistant.id %>" class="flex justify-start">
  <div class="max-w-[85%]">
    <div class="mb-1 flex items-baseline gap-2 px-1 text-xs text-base-content/50">
      <span class="font-medium"><%= t ".name" %></span>
      <time><%= format_time assistant.created_at %></time>
    </div>
    <div id="ai_message_<%= assistant.id %>_content" class="rounded-2xl rounded-tl-sm bg-base-200 px-4 py-2.5 whitespace-pre-wrap break-words"><%= assistant.content %></div>
  </div>
</div>
