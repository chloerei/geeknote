<%# locals: (tool:) %>
<%# AI::Message tool result; rendered as the "output" section of a tool-call
    collapse card, both on full page loads and when streamed in live via
    Turbo (AI::Message#broadcast_message_created). %>
<% if (error_message = tool.tool_error_message).present? %>
  <div class="rounded-lg border border-error/30 bg-error/10 px-2.5 py-2 font-mono text-xs text-error break-words"><%= error_message %></div>
<% else %>
  <pre class="rounded-lg bg-base-100/70 px-2.5 py-2 font-mono text-xs whitespace-pre-wrap break-all"><%= tool.content.presence || t(".no_output") %></pre>
<% end %>
