<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "ai/messages/error",
    message: tool,
    title: t(".error_title"),
    error_message: error_message %>
<% else %>
  <div id="ai_message_tool_result_<%= tool.id %>" class="chat chat-start">
    <div class="chat-header"><%= t ".name" %></div>
    <div class="chat-bubble chat-bubble-ghost whitespace-pre-wrap text-sm"><%= tool.content.presence || t(".no_output") %></div>
  </div>
<% end %>
