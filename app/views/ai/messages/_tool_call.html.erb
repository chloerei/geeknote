<%# locals: (tool_call_record:) %>
<%# RubyLLM::ActiveRecord::ToolCall with :result preloaded.
    While the call is pending (no result yet) its title leads with a spinner
    instead of the tool icon and the output area shows a "running" placeholder;
    once the result row is persisted the whole card is replaced by this render
    with the tool icon and result in place (AI::Message#broadcast_tool_result_to_parent). %>
<% tool_call = tool_call_record.to_llm %>
<% result = tool_call_record.result %>

<div id="ai_message_tool_call_<%= tool_call.id %>" class="mt-2 w-full min-w-0">
  <div class="collapse collapse-arrow">
    <input type="checkbox" aria-label="<%= t ".toggle" %>" />
    <div class="collapse-title flex items-center gap-2 py-1 pl-0 pr-9 text-sm font-medium">
      <% if result.present? %>
        <% case tool_call.name %>
        <% when "read_snapshot" %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide shrink-0 text-base-content/50"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <% when "change_title", "write_content", "edit_content" %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide shrink-0 text-base-content/50"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
        <% else %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide shrink-0 text-base-content/50"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <% end %>
      <% else %>
        <span class="loading loading-spinner loading-xs text-base-content/50" role="status"></span>
      <% end %>
      <span class="text-xs text-base-content/80"><%= t ".names.#{tool_call.name}", default: tool_call.name %></span>
    </div>
    <div class="collapse-content pb-0 pl-0 pr-0">
      <div class="mt-1 ml-1 space-y-3 border-l-2 border-base-300/70 pb-2 pl-4">
        <div>
          <div class="text-[10px] font-medium uppercase tracking-wide text-base-content/50"><%= t ".input" %></div>
          <div class="mt-1">
            <%= render tool_call_partial(tool_call), tool_call: tool_call %>
          </div>
        </div>

        <div>
          <div class="text-[10px] font-medium uppercase tracking-wide text-base-content/50"><%= t ".output" %></div>
          <div class="mt-1">
            <% if result.present? %>
              <%= render tool_result_partial(result), tool: result %>
            <% else %>
              <div class="flex items-center gap-2 rounded-lg bg-base-200 px-2.5 py-2 text-xs text-base-content/50">
                <span class="loading loading-dots loading-sm" role="status"></span>
                <span><%= t ".running" %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
