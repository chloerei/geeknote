<div id="ai_message_tool_call_<%= tool_call.id %>" class="chat chat-start">
  <div class="chat-header"><%= t ".name" %></div>
  <div class="chat-bubble chat-bubble-ghost whitespace-pre-wrap text-sm"><%= tool_call.name %>(<%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %>)</div>
</div>
