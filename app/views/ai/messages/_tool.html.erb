<%# Fallback used only when a tool result row is rendered standalone (the
    normal path renders it inside its parent tool-call collapse). %>
<% tool ||= local_assigns[:message] %>
<div id="ai_message_tool_result_<%= tool.id %>" class="flex justify-start">
  <div class="w-full px-4">
    <%= render tool_result_partial(tool), tool: tool %>
  </div>
</div>
