<% user ||= local_assigns[:message] %>
<div id="ai_message_<%= user.id %>" class="chat chat-end">
  <div class="chat-header">
    <%= t ".name" %>
    <time class="text-xs opacity-50"><%= format_time user.created_at %></time>
  </div>
  <div id="ai_message_<%= user.id %>_content" class="chat-bubble chat-bubble-primary whitespace-pre-wrap"><%= user.content %></div>
</div>
