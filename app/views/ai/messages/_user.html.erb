<% user ||= local_assigns[:message] %>
<div id="ai_message_<%= user.id %>" class="flex justify-end">
  <div class="max-w-[85%]">
    <div data-controller="streaming-markdown" class="rounded-2xl rounded-tr-sm bg-primary px-4 py-2.5 text-primary-content break-words">
      <div id="ai_message_<%= user.id %>_content" data-streaming-markdown-target="raw" class="chat-raw whitespace-pre-wrap"><%= user.content %></div>
      <div data-streaming-markdown-target="rendered" class="chat-markdown typography"></div>
    </div>
  </div>
</div>
