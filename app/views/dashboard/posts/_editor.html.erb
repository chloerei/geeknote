<%# locals: (post:) %>
<% editor_form_id = "editor-form" %>

<div id="post-editor" class="h-dvh flex flex-col overflow-hidden" data-controller="form-unsave-checker">
  <div class="drawer drawer-end lg:drawer-open grow min-h-0 auto-rows-[minmax(0,1fr)]" data-controller="drawer-panels" data-action="turbo:morph@window->drawer-panels#afterMorph">
    <input type="checkbox" id="drawer-toggle" class="drawer-toggle" data-drawer-panels-target="toggle" data-action="change->drawer-panels#toggleChanged" data-turbo-permanent>

    <div class="drawer-content overflow-y-auto">
      <div class="navbar sticky top-0 z-10 px-4 gap-4 bg-base-200 border-b border-base-300">
        <div class="flex-none">
          <a href="<%= dashboard_posts_path(post.account.name) %>" class="btn btn-ghost btn-square">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          </a>
        </div>
        <div class="grow flex items-center gap-2">
          <div class="text-xl font-medium">
            <%= t "general.posts" %>
          </div>
          <% if post.draft? %>
            <div class="btn btn-disabled btn-ghost text-base-content/80">
              <%= t "general.draft" %>
            </div>
          <% elsif post.published? %>
            <a href="<%= account_post_path(post.account.name, post) %>" class="btn btn-ghost text-base-content/80" target="_blank">
              <%= t "general.published" %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right-icon lucide-arrow-up-right"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>
          <% end %>
        </div>
        <div class="flex-none flex items-center gap-2">
          <button type="button" class="btn btn-ghost btn-square" data-drawer-panels-target="button" data-action="drawer-panels#toggle" data-panel="ai">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles-icon lucide-sparkles"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
          </button>
          <button type="button" class="btn btn-ghost btn-square" data-drawer-panels-target="button" data-action="drawer-panels#toggle" data-panel="settings">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings-2-icon lucide-settings-2"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
          </button>
          <% if post.draft? %>
            <button type="submit" form="<%= editor_form_id %>" class="btn btn-ghost" data-controller="hotkey" data-hotkey="Mod+s" data-hotkey-global>
              <%= t "general.save" %>
            </button>
            <% if post.persisted? %>
              <%= form_with url: dashboard_post_publish_path(post.account.name, post), method: :patch do %>
                <button type="submit" class="btn btn-ghost text-primary">
                  <%= t "general.publish" %>
                </button>
              <% end %>
            <% else %>
              <button type="button" class="btn btn-ghost" disabled>
                <%= t "general.publish" %>
              </button>
            <% end %>
          <% elsif post.published? %>
            <button type="submit" form="<%= editor_form_id %>" class="btn btn-ghost text-primary" data-controller="hotkey" data-hotkey="Mod+s" data-hotkey-global>
              <%= t "general.update" %>
            </button>
            <%= form_with url: dashboard_post_publish_path(post.account.name, post), method: :delete do %>
              <button type="submit" class="btn btn-ghost">
                <%= t "general.unpublish" %>
              </button>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="max-w-4xl mx-auto p-4">
        <div id="editor-card" class="card card-lg card-default" data-turbo-permanent>
          <div class="card-body">
            <%= form_with model: post, url: post.new_record? ? dashboard_posts_path(post.account.name) : dashboard_post_path(post.account.name, post), id: editor_form_id do |form| %>
              <%= form.text_area :title, class: "text-3xl font-medium resize-none outline-none w-full", placeholder: t(".title_placeholder"), data: { controller: "autoresize" } %>

              <div class="group" data-controller="markdown-field">
                <%= form.hidden_field :content, id: "post_content", placeholder: t(".content_placeholder") %>
                <markdown-editor input="<%= form.field_id :content %>" class="mt-4 min-h-screen" data-markdown-field-target="markdownEditor"></markdown-editor>

                <div class="sticky bottom-4 flex justify-center mt-4">
                  <div class="bg-base-200 p-1 rounded-full flex gap-1 shadow-sm">
                    <div class="join">
                      <button type="button" class="btn btn-ghost join-item not-group-[.previewing]:btn-active!" data-action="markdown-field#edit">
                        <%= t "general.edit" %>
                      </button>
                      <button type="button" class="btn btn-ghost join-item group-[.previewing]:btn-active!" data-action="markdown-field#preview">
                        <%= t "general.preview" %>
                      </button>
                    </div>
                    <div class="block group-[.previewing]:hidden">
                      <button type="button" class="btn btn-ghost btn-square" data-action="markdown-field#attachFile">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-paperclip-icon lucide-paperclip"><path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"/></svg>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="drawer-side">
      <label for="drawer-toggle" class="drawer-overlay"></label>

      <div class="bg-base-100 border-l border-base-300 text-base-content h-full flex flex-col overflow-hidden is-drawer-close:w-0 is-drawer-open:w-[400px]">
        <div class="w-[400px] flex flex-col grow min-h-0 lg:is-drawer-close:hidden" data-drawer-panels-target="panel" data-panel="settings">
          <div class="navbar border-b border-base-300">
            <div class="grow px-2">
              <div class="text-xl font-medium">
                <%= t "general.settings" %>
              </div>
            </div>
            <label for="drawer-toggle" class="btn btn-ghost btn-square">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </label>
          </div>

          <div class="grow p-4 overflow-auto">
            <%= fields_for post do |form| %>
              <div class="space-y-2">
                <%= render "components/image_field", form: form, name: :featured_image, options: { form: editor_form_id } %>

                <fieldset class="fieldset">
                  <legend class="fieldset-legend">
                    <%= t "general.tags" %>
                  </legend>
                  <div data-controller="tag-field" data-turbo-permanent>
                    <%= form.hidden_field :tag_list, form: editor_form_id, data: { tag_field_target: "input" } %>
                  </div>
                </fieldset>

                <fieldset class="fieldset">
                  <legend class="fieldset-legend">
                    <%= t "general.series" %>
                  </legend>
                  <%= form.collection_select :series_id, post.account.series.order(:title), :id, :title, { include_blank: t(".no_series") }, { class: "select w-full", form: editor_form_id } %>
                </fieldset>

                <%= render "components/text_field", form: form, name: :canonical_url, options: { form: editor_form_id } %>

                <fieldset class="fieldset">
                  <legend class="fieldset-legend">
                    <%= t "general.options" %>
                  </legend>
                  <%= render "components/checkbox_field", form: form, name: :allow_comments, options: { form: editor_form_id } %>
                </fieldset>
              </div>
            <% end %>

            <% if post.persisted? %>
              <div class="divider"></div>

              <a href="<%= dashboard_post_ai_chats_path(post.account.name, post) %>" class="btn btn-outline w-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles-icon lucide-sparkles"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
                <%= t ".ai_chat" %>
              </a>

              <a href="<%= dashboard_post_revisions_path(post.account.name, post) %>" class="btn btn-outline w-full mt-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-history-icon lucide-history"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                <%= t ".revisions" %>
              </a>

              <%= form_with url: dashboard_post_path(post.account.name, post), method: :delete, data: { turbo_confirm: t(".delete_forever_confirm") } do %>
                <button type="submit" class="btn btn-outline btn-error w-full mt-2">
                  <%= t "general.delete_post" %>
                </button>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="w-[400px] flex flex-col grow min-h-0 lg:is-drawer-close:hidden" data-drawer-panels-target="panel" data-panel="ai">
          <% if post.persisted? %>
            <%= turbo_frame_tag "ai-panel", src: dashboard_post_ai_chats_path(post.account.name, post), loading: :lazy, class: "flex flex-col grow min-h-0", data: { turbo_permanent: true } do %>
              <div class="grow min-h-0 overflow-auto p-4">
                <div class="p-2 space-y-2">
                  <div class="h-10 rounded-lg bg-base-200 animate-pulse"></div>
                  <div class="h-10 rounded-lg bg-base-200 animate-pulse"></div>
                  <div class="h-10 rounded-lg bg-base-200 animate-pulse"></div>
                  <div class="h-10 rounded-lg bg-base-200 animate-pulse"></div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="grow min-h-0 overflow-auto p-4">
              <div class="text-center text-base-content/60 py-8">
                <%= t ".ai_panel_save_first" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
