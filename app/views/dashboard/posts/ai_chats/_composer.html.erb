<%# locals: (form:, field:, rows: 2, placeholder:, resizable: false, busy: false, cancel_path: nil) %>

<div class="rounded-2xl border border-base-300 bg-base-100 p-2 transition-colors focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20">
  <%# Enter-to-submit is bound to the textarea (not the send button) so that
      replacing just the button area while processing never needs rebinding;
      in the busy state there is no submit button and ai-composer ignores Enter. %>
  <%= form.text_area field,
    rows: rows,
    id: form.field_id(field),
    placeholder: placeholder,
    autofocus: true,
    data: {
      controller: (resizable ? "autoresize" : nil),
      action: "keydown->ai-composer#submitOnEnter"
    }.compact,
    class: "textarea w-full border-0 bg-transparent resize-none px-2 py-1.5 min-h-[2lh] shadow-none focus:outline-none" %>

  <div class="flex items-center justify-between gap-1 pt-1">
    <div class="flex items-center gap-1">
      <%# Reserved for future auxiliary buttons (e.g. attachments) %>
    </div>
    <%= render "dashboard/posts/ai_chats/composer_actions", busy: busy, cancel_path: cancel_path %>
  </div>
</div>
