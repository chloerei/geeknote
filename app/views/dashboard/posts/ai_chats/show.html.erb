<% @show_dock = true %>

<%= turbo_stream_from "ai_chat_#{@ai_chat.id}" %>

<div class="navbar px-0 gap-4">
  <div class="flex-none">
    <a href="<%= dashboard_post_ai_chats_path(@account.name, @post) %>" class="btn btn-ghost btn-square">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    </a>
  </div>
  <div class="flex-grow">
    <div class="text-xl font-medium truncate">
      <%= @ai_chat.title || t(".untitled") %>
    </div>
    <div class="text-sm text-base-content/60">
      <%= @ai_chat.model&.label || default_model_display_name %>
    </div>
  </div>
  <div class="flex-none">
    <%= button_to t("general.delete"), dashboard_post_ai_chat_path(@account.name, @post, @ai_chat), method: :delete, class: "btn btn-ghost btn-square text-error", data: { turbo_confirm: t(".delete_confirm") } %>
  </div>
</div>

<div class="card card-default">
  <div class="card-body">
    <div id="ai_messages" class="space-y-4 min-h-[50vh]">
      <% if @ai_chat.ai_messages.any? %>
        <% @ai_chat.ai_messages.each do |ai_message| %>
          <%= render partial: ai_message.to_partial_path, object: ai_message %>
        <% end %>
      <% else %>
        <div class="text-center text-base-content/60 py-8">
          <%= t ".empty" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render "dashboard/posts/ai_chats/messages/form", ai_chat: @ai_chat, ai_message: @ai_message %>
