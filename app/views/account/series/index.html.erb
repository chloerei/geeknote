<div class="navbar px-0 gap-4">
  <div class="flex-none">
    <a href="<%= root_path %>" class="btn btn-square btn-ghost">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    </a>
  </div>
  <div class="grow">
    <div class="text-xl font-medium">
      <%= @account.owner.name %>
    </div>
  </div>
</div>

<div class="layout-main-sidebar">
  <div>
    <%= render "account/profile_card", account: @account %>

    <div class="mt-4">
      <%= render "account/tabs", active_tab: "series" %>
    </div>

    <div class="mt-4">
      <div id="series_list" class="space-y-4" data-controller="scroll-pagination">
        <%= render partial: "account/series/series", collection: @series, as: :series %>
        <% if @pagy.next %>
          <a href="<%= pagy_url_for(@pagy, @pagy.next) %>" class="btn btn-ghost btn-block" data-action="scroll-pagination#load" data-scroll-pagination-target="nextLink" data-turbo-prefetch="false">
            <%= t "general.load_more" %>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
          </a>
        <% else %>
          <div class="text-center text-xs opacity-60 py-4"><%= t "general.end_label" %></div>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "account/sidebar", account: @account %>
</div>
