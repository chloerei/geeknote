<div class="navbar px-0 gap-4">
  <div class="flex-none">
    <a href="<%= account_post_path(@account.name, @post) %>" class="btn btn-square btn-ghost">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    </a>
  </div>
  <div class="flex-grow">
    <div class="text-xl font-medium">
      <%= t "general.comments" %>
    </div>
  </div>
</div>

<div class="layout-main-sidebar">
  <div>
    <% if @post.allow_comments? %>
      <div class="card card-default">
        <div class="card-body">
          <div class="card-title">
            <%= t "general.new_comment" %>
          </div>

          <% if Current.user %>
            <%= render "account/comments/form", comment: Current.user.comments.new(commentable: @post), open: params[:comment].present? %>
          <% else %>
            <div class="py-4">
              <a href="<%= new_session_path %>" class="btn btn-primary">
                <%= t "general.sign_in_to_comment" %>
              </a>
            </div>
          <% end %>
        </div>
      </div>

      <div id="comments" class="card card-default mt-4">
        <div class="card-body">
          <div class="flex items-center gap-4 pb-4 border-b border-base-300">
            <div class="card-title flex-grow">
              <%= t "general.all_comments" %> <%= @pagy.count %>
            </div>
            <div class="dropdown">
              <label tabindex="0" class="btn btn-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down-wide-narrow-icon lucide-arrow-down-wide-narrow"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="M11 4h10"/><path d="M11 8h7"/><path d="M11 12h4"/></svg>
                <%=
                  case @sort
                  when "oldest"
                    t("general.oldest")
                  when "popular"
                    t("general.popular")
                  else
                    t("general.newest")
                  end
                %>
              </label>
              <ul class="dropdown-content menu w-52 bg-base-100 p-2 shadow-sm">
                <li>
                  <a href="<%= url_for(sort: nil) %>">
                    <%= t "general.newest" %>
                  </a>
                </li>
                <li>
                  <a href="<%= url_for(sort: "oldest") %>">
                    <%= t "general.oldest" %>
                  </a>
                </li>
                <li>
                  <a href="<%= url_for(sort: "popular") %>">
                    <%= t "general.popular" %>
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <div class="">
            <div id="comments_list" data-controller="scroll-pagination">
              <%= render partial: "account/comments/comment", collection: @comments, cached: -> comment { [ comment.user, comment ]} %>
              <%= render "account/comments/status", comments: @comments %>
              <% if @pagy.next %>
                <a href="<%= pagy_url_for(@pagy, @pagy.next) %>" class="btn btn-ghost btn-block" data-action="scroll-pagination#load" data-scroll-pagination-target="nextLink" data-turbo-prefetch="false">
                  <%= t "general.load_more" %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
                </a>
              <% else %>
                <div class="text-center text-xs opacity-60 py-4"><%= t "general.end_label" %></div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="card card-default p-4">
        <div class="card-body">
          <div class="flex items-center justify-center gap-4 text-base-content/80">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle-off-icon lucide-message-circle-off"><path d="m2 2 20 20"/><path d="M4.93 4.929a10 10 0 0 0-1.938 11.412 2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 0 0 11.302-1.989"/><path d="M8.35 2.69A10 10 0 0 1 21.3 15.65"/></svg>
            <div class="text-sm">
              <%= t "general.comments_is_disabled" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div>

  </div>
</div>
